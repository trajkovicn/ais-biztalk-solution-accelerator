{
  "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "config": {
      "isWizard": true,
      "basics": {
        "description": "Deploy a DEV Azure Integration Services (AIS) baseline: Logic Apps (Consumption) + Service Bus + ADLS Gen2 + Integration Account + Key Vault. Includes Hello World XML ingress and a sample Liquid transform."
      }
    },
    "basics": [
      {
        "name": "ou",
        "type": "Microsoft.Common.TextBox",
        "label": "Organizational Unit (OU)",
        "toolTip": "Example: fin, hr, it",
        "constraints": {
          "required": true,
          "validations": [
            {
              "regex": "^[a-z0-9]{2,10}$",
              "message": "2-10 lowercase letters/numbers."
            }
          ]
        }
      },
      {
        "name": "biz",
        "type": "Microsoft.Common.TextBox",
        "label": "Business area",
        "toolTip": "Example: tax, rev, ops",
        "constraints": {
          "required": true,
          "validations": [
            {
              "regex": "^[a-z0-9]{2,10}$",
              "message": "2-10 lowercase letters/numbers."
            }
          ]
        }
      },
      {
        "name": "app",
        "type": "Microsoft.Common.TextBox",
        "label": "Workload / App",
        "defaultValue": "btmigr",
        "constraints": {
          "required": true,
          "validations": [
            {
              "regex": "^[a-z0-9]{2,15}$",
              "message": "2-15 lowercase letters/numbers."
            }
          ]
        }
      }
    ],
    "steps": [
      {
        "name": "naming",
        "label": "Naming",
        "elements": [
          {
            "name": "regionCode",
            "type": "Microsoft.Common.TextBox",
            "label": "Region code (naming)",
            "toolTip": "Example: eus, wus2",
            "constraints": {
              "required": true,
              "validations": [
                {
                  "regex": "^[a-z0-9]{2,8}$",
                  "message": "2-8 lowercase letters/numbers."
                }
              ]
            }
          },
          {
            "name": "instance",
            "type": "Microsoft.Common.TextBox",
            "label": "Instance",
            "defaultValue": "001",
            "constraints": {
              "required": true,
              "validations": [
                {
                  "regex": "^[0-9]{3}$",
                  "message": "Use a 3-digit number, e.g., 001."
                }
              ]
            }
          },
          {
            "name": "env",
            "type": "Microsoft.Common.TextBlock",
            "label": "Environment",
            "defaultValue": "dev (fixed)"
          }
        ]
      },
      {
        "name": "networking",
        "label": "Networking (VNet)",
        "elements": [
          {
            "name": "deployVnet",
            "type": "Microsoft.Common.CheckBox",
            "label": "Deploy a private Virtual Network with pre-defined subnets",
            "defaultValue": false
          },
          {
            "name": "vnetAddressPrefix",
            "type": "Microsoft.Common.TextBox",
            "label": "VNet address space (CIDR)",
            "defaultValue": "10.10.0.0/22",
            "visible": "[steps('networking').deployVnet]",
            "constraints": {
              "required": true,
              "validations": [
                {
                  "regex": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$",
                  "message": "Enter a valid CIDR block, e.g. 10.10.0.0/22."
                }
              ]
            }
          },
          {
            "name": "deployDnsResolverSubnets",
            "type": "Microsoft.Common.CheckBox",
            "label": "Deploy Azure DNS Private Resolver subnets",
            "visible": "[steps('networking').deployVnet]",
            "defaultValue": false
          },
          {
            "name": "vnetNote",
            "type": "Microsoft.Common.InfoBox",
            "visible": "[steps('networking').deployVnet]",
            "options": {
              "icon": "Info",
              "text": "Creates a VNet with subnets for Private Endpoints, Service Bus, Key Vault, and Storage. Optional DNS Resolver subnets can also be added."
            }
          }
        ]
      },
      {
        "name": "integration",
        "label": "Integration Account",
        "elements": [
          {
            "name": "deployIntegrationAccount",
            "type": "Microsoft.Common.CheckBox",
            "label": "Deploy Integration Account",
            "defaultValue": true
          },
          {
            "name": "integrationAccountSku",
            "type": "Microsoft.Common.DropDown",
            "label": "Integration Account SKU",
            "defaultValue": "Basic",
            "visible": "[steps('integration').deployIntegrationAccount]",
            "constraints": {
              "allowedValues": [
                {
                  "label": "Free",
                  "value": "Free"
                },
                {
                  "label": "Basic",
                  "value": "Basic"
                },
                {
                  "label": "Standard",
                  "value": "Standard"
                }
              ],
              "required": true
            }
          },
          {
            "name": "liquidNote",
            "type": "Microsoft.Common.InfoBox",
            "visible": "[steps('integration').deployIntegrationAccount]",
            "options": {
              "icon": "Info",
              "text": "Includes a starter Liquid map (XML->JSON) and an optional sample Liquid Logic App."
            }
          }
        ]
      },
      {
        "name": "security",
        "label": "Security (Key Vault)",
        "elements": [
          {
            "name": "keyVaultAdminObjectId",
            "type": "Microsoft.Common.TextBox",
            "label": "Key Vault admin Object ID (user or group)",
            "toolTip": "Microsoft Entra objectId (GUID) for a user or group granted secret permissions.",
            "constraints": {
              "required": true,
              "validations": [
                {
                  "regex": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$",
                  "message": "Enter a valid GUID."
                }
              ]
            }
          },
          {
            "name": "kvNote",
            "type": "Microsoft.Common.InfoBox",
            "options": {
              "icon": "Info",
              "text": "The deployment creates a Key Vault and stores generated connection strings/keys as secrets."
            }
          }
        ]
      }
    ],
    "outputs": {
      "ou": "[basics('ou')]",
      "biz": "[basics('biz')]",
      "app": "[basics('app')]",
      "env": "dev",
      "regionCode": "[steps('naming').regionCode]",
      "instance": "[steps('naming').instance]",
      "deployVnet": "[steps('networking').deployVnet]",
      "vnetAddressPrefix": "[steps('networking').vnetAddressPrefix]",
      "deployDnsResolverSubnets": "[steps('networking').deployDnsResolverSubnets]",
      "deployIntegrationAccount": "[steps('integration').deployIntegrationAccount]",
      "integrationAccountSku": "[steps('integration').integrationAccountSku]",
      "keyVaultAdminObjectId": "[steps('security').keyVaultAdminObjectId]",
      "location": "[location()]"
    }
  }
}
